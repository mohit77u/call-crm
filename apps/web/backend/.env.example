# Postgres connection string (Render Postgres in production)
DATABASE_URL=

# Long random string for signing JWTs, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# Port the API listens on
PORT=4000

# JWT lifetimes (jsonwebtoken expiresIn format)
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=180d

# Comma-separated allowed browser origins (your Vercel frontend URL).
# Mobile app does not need CORS. Example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3050

# Public URL of the frontend (used in password reset emails)
APP_URL=http://localhost:3050

# Where contact/enquiry form submissions are emailed
CONTACT_TO=sales@callcrm.app

# Timezone used for call log date filters
CRM_TIME_ZONE=Asia/Kolkata

# Optional: seed superadmins on first boot — comma-separated emails, one shared password.
# Existing accounts are never overwritten (a changed password stays changed).
SUPERADMIN_EMAILS=admin@example.com,second@example.com
SUPERADMIN_PASSWORD=

# Optional SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
